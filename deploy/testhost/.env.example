# Welches Image `docker-compose.yml` zieht (ghcr.io/lucienkerl/loxmatter:<Tag>).
# Ohne diese Zeile griffe Composes eigener Default (`:-stable`) unsichtbar -
# hier wird derselbe Wert trotzdem ausgeschrieben, aus zwei Gruenden: der
# Updater der naechsten Stufe rollt ein fehlgeschlagenes Update zurueck,
# indem er genau diese Zeile umschreibt - eine vorhandene Zeile ersetzt er
# an Ort und Stelle, eine fehlende muesste er erst anhaengen, und seine
# Pruefung "nur vorwaerts, nie rueckwaerts" vergleicht gegen das, was hier
# steht. Und "stable" ist ein wandernder Alias, kein fester Stand -
# ausgeschrieben macht das sichtbar, dass diese Installation einem Kanal
# folgt statt einer gepinnten Version, und macht "dev" (der rollende Kanal
# aus dem jeweils neuesten main) als Alternative auffindbar.
LOXMATTER_IMAGE_TAG=stable

# Betriebsart. Leer = nur WLAN- und Ethernet-Matter-Geraete; "thread" nimmt
# zusaetzlich den OpenThread Border Router (Dienst `otbr`) dazu.
#
# Compose reads this variable from the .env by itself - that's why the
# operating mode lives here rather than as a `--profile` argument on every
# call. A later `docker compose up`, `scripts/update.sh` and the watchdog
# all pick the right one automatically as a result.
#
# Retrofitting: plug in the radio module, set `thread` here, point
# RADIO_DEVICE below at the right path, run `docker compose up -d` again.
COMPOSE_PROFILES=thread

# The next three variables (RADIO_DEVICE, RADIO_BAUDRATE, BACKBONE_IF) are
# only needed by the otbr service and therefore only by
# COMPOSE_PROFILES=thread - without that profile otbr is never created and
# none of them is ever read.
RADIO_DEVICE=/dev/ttyUSB0
RADIO_BAUDRATE=460800
BACKBONE_IF=wlan0
# id of the Bluetooth adapter (from `hci0` -> 0) for BLE commissioning by
# matter-server. The Pi only has hci0, hence 0; see the README's "Enable
# BLE".
BLUETOOTH_ADAPTER=0

# IP of the Loxone Miniserver, as seen from this host (for the loxmatter
# service, Phase 4). No sensible default - without this variable
# `loxmatter run` starts with an empty --miniserver address.
MINISERVER_IP=

# Protects the WebUI's `/api` routes (commissioning, removal, fabric
# backup) with `Authorization: Bearer <token>` (Task 8, Phase 5, Spec 9).
# `/cmd`/`/resync` for the Miniserver are unaffected by this.
#
#   OPTIONAL since the WebUI login (Task 9/10, Phase 6). Access to the
#   interface itself no longer runs through this token but through a
#   password set on the first call to `http://<host>:8080/` - until then
#   NO `/api` route returns anything (401), with or without a token, an
#   open state no longer exists. This token remains worthwhile anyway: it's
#   the way for scripts and `curl`, which cannot log in via a browser, and
#   it works independently of the first-run setup status. Anyone who only
#   uses the WebUI can leave this variable empty.
#
# Generate with:
#
#   openssl rand -hex 32
#
# Exactly this way, not any random string: the token must be transmittable
# in an HTTP header and in a WebSocket subprotocol - no spaces, no comma,
# no non-ASCII. `openssl rand -hex 32` produces only [0-9a-f] and satisfies
# that by construction. A token consisting only of whitespace (say, a
# stray line break) counts as "unset".
LOXMATTER_API_TOKEN=
