"""The firmware update queue (design 2026-10-01, sections 2 and 4)."""

import asyncio

from firmware_fakes import (
    BILRESA_OFFER,
    KAJPLATS_OFFER,
    FakeFirmwareSource,
    idle_facts,
    register,
)

from loxmatter import i18n
from loxmatter.firmware import states
from loxmatter.firmware.job import FirmwareJobs, JobTiming
from loxmatter.firmware.queue import (
    HALTED_DISCONNECTED,
    HALTED_UNSUPPORTED,
    FirmwareQueue,
)
from loxmatter.model.store import Store

LAMP_TARGET = KAJPLATS_OFFER.software_version
BUTTON_TARGET = BILRESA_OFFER.software_version


class Clock:
    """A clock the fake sleep advances; `script` runs source changes at
    given times, like a device reporting its state."""

    def __init__(self) -> None:
        self.t = 0.0
        self.script: list[tuple[float, object]] = []

    def __call__(self) -> float:
        return self.t

    async def sleep(self, seconds: float) -> None:
        self.t += seconds
        while self.script and self.script[0][0] <= self.t:
            _, action = self.script.pop(0)
            action()  # type: ignore[operator]
        await asyncio.sleep(0)


def _setup(tmp_path):
    store = Store(tmp_path / "t.sqlite")
    lamp_id, lamp = register(store, "ikea_kajplats_cws_lamp.json")
    button_id, button = register(store, "ikea_bilresa_button.json")
    store.firmware_status.record_check(lamp_id, KAJPLATS_OFFER, "t0")
    store.firmware_status.record_check(button_id, BILRESA_OFFER, "t0")
    source = FakeFirmwareSource()
    source.facts[lamp] = idle_facts(16842752, "1.1.0")
    source.facts[button] = idle_facts(17301509, "1.8.5")
    clock = Clock()
    jobs = FirmwareJobs(
        store, lambda: source, clock=clock, sleep=clock.sleep, now=lambda: "now", timing=JobTiming()
    )
    queue = FirmwareQueue(store, jobs, lambda: source, now=lambda: "q")
    return store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button)


def _auto_finish(source, clock, versions):
    """Every started install reports its new version 10 fake seconds later."""
    original = source.start_update

    async def start_update(address, software_version):
        await original(address, software_version)
        clock.script.append(
            (clock.t + 10, lambda: source.finish(address, software_version, versions[address]))
        )
        clock.script.sort(key=lambda entry: entry[0])

    source.start_update = start_update


async def _idle(queue):
    await asyncio.wait_for(queue.wait_idle(), timeout=5)


async def _close(queue, jobs):
    await queue.stop()
    await jobs.stop()


async def test_devices_are_installed_one_after_another(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button) = _setup(tmp_path)
    _auto_finish(source, clock, {lamp: "1.2.0", button: "1.9.15"})
    assert queue.enqueue([button_id, lamp_id]) == 2
    order = store.firmware_status.queued()
    assert order == [lamp_id, button_id]
    queue.start()
    await _idle(queue)

    by_id = {lamp_id: (lamp, LAMP_TARGET), button_id: (button, BUTTON_TARGET)}
    assert source.started == [by_id[device_id] for device_id in order]
    assert store.firmware_status.get(lamp_id).offer is None
    assert store.firmware_status.get(button_id).offer is None
    assert store.firmware_status.queued() == []
    assert queue.active is False
    await _close(queue, jobs)


async def test_enqueue_ignores_devices_without_an_offer(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, _), (button_id, _) = _setup(tmp_path)
    store.firmware_status.drop_offer(button_id)
    assert queue.enqueue([lamp_id, button_id]) == 1
    assert store.firmware_status.queued() == [lamp_id]
    await _close(queue, jobs)


async def test_enqueue_ignores_unknown_and_forgotten_devices(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, _), (button_id, _) = _setup(tmp_path)
    store.forget_device(button_id)
    assert queue.enqueue([lamp_id, button_id, 9999]) == 1
    assert store.firmware_status.queued() == [lamp_id]
    await _close(queue, jobs)


async def test_a_device_that_already_has_the_version_is_skipped(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button) = _setup(tmp_path)
    _auto_finish(source, clock, {button: "1.9.15"})
    source.facts[lamp] = idle_facts(LAMP_TARGET, "1.2.0")
    queue.enqueue([lamp_id, button_id])
    queue.start()
    await _idle(queue)

    assert source.started == [(button, BUTTON_TARGET)]
    assert store.firmware_status.get(lamp_id).job_error is None
    assert store.firmware_status.queued() == []
    await _close(queue, jobs)


async def test_an_offline_device_fails_and_the_next_one_runs(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button) = _setup(tmp_path)
    _auto_finish(source, clock, {button: "1.9.15"})
    source.facts[lamp] = idle_facts(16842752, "1.1.0", available=False)
    queue.enqueue([lamp_id, button_id])
    queue.start()
    await _idle(queue)

    lamp_status = store.firmware_status.get(lamp_id)
    assert lamp_status.job_state == states.FAILED
    assert lamp_status.job_error == i18n.t("api.firmware.queue_offline_at_turn")
    assert source.started == [(button, BUTTON_TARGET)]
    assert store.firmware_status.get(button_id).offer is None
    await _close(queue, jobs)


async def test_a_failed_install_does_not_stop_the_queue(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button) = _setup(tmp_path)
    _auto_finish(source, clock, {lamp: "1.2.0", button: "1.9.15"})
    original = source.start_update
    calls = []

    async def start_update(address, software_version):
        calls.append(address)
        if len(calls) == 1:
            source.started.append((address, software_version))
            raise RuntimeError("boom")
        await original(address, software_version)

    source.start_update = start_update
    queue.enqueue([lamp_id, button_id])
    queue.start()
    await _idle(queue)

    assert store.firmware_status.get(lamp_id).job_state == states.FAILED
    assert store.firmware_status.get(button_id).offer is None
    assert [address for address, _ in source.started] == [lamp, button]
    await _close(queue, jobs)


def _interrupt_first(source, clock, versions):
    _auto_finish(source, clock, versions)
    clock.script.append((4, lambda: setattr(source, "connected", False)))
    clock.script.sort(key=lambda entry: entry[0])


async def test_an_interrupted_install_halts_the_queue(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button) = _setup(tmp_path)
    _interrupt_first(source, clock, {lamp: "1.2.0", button: "1.9.15"})
    queue.enqueue([lamp_id, button_id])
    queue.start()
    await _idle(queue)

    assert store.firmware_status.get(lamp_id).job_state == states.INTERRUPTED
    assert store.firmware_status.queued() == [button_id]
    assert store.firmware_settings.get_queue_halted_reason() == HALTED_DISCONNECTED
    assert queue.active is False
    assert source.started == [(lamp, LAMP_TARGET)]
    await _close(queue, jobs)


async def test_resume_continues_after_a_halt(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button) = _setup(tmp_path)
    _interrupt_first(source, clock, {lamp: "1.2.0", button: "1.9.15"})
    queue.enqueue([lamp_id, button_id])
    queue.start()
    await _idle(queue)

    source.connected = True
    queue.resume()
    await _idle(queue)

    assert source.started[-1] == (button, BUTTON_TARGET)
    assert store.firmware_status.get(button_id).offer is None
    assert store.firmware_settings.get_queue_halted_reason() is None
    await _close(queue, jobs)


async def test_unsupported_halts_and_keeps_the_device(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, _), (button_id, _) = _setup(tmp_path)
    source.supported = False
    queue.enqueue([lamp_id, button_id])
    queue.start()
    await _idle(queue)

    assert store.firmware_settings.get_queue_halted_reason() == HALTED_UNSUPPORTED
    assert store.firmware_status.queued() == [lamp_id, button_id]
    assert source.started == []
    await _close(queue, jobs)


async def test_clear_empties_the_queue_and_the_halt(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, _), (button_id, _) = _setup(tmp_path)
    queue.enqueue([lamp_id, button_id])
    store.firmware_settings.set_queue_halted_reason(HALTED_UNSUPPORTED)
    queue.clear()
    assert store.firmware_status.queued() == []
    assert store.firmware_settings.get_queue_halted_reason() is None
    await _close(queue, jobs)


async def test_the_queue_is_picked_up_from_the_store(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button) = _setup(tmp_path)
    _auto_finish(source, clock, {lamp: "1.2.0", button: "1.9.15"})
    queue.enqueue([lamp_id, button_id])

    second = FirmwareQueue(store, jobs, lambda: source, now=lambda: "q")
    second.start()
    await _idle(second)

    assert store.firmware_status.get(lamp_id).offer is None
    assert store.firmware_status.get(button_id).offer is None
    await second.stop()
    await _close(queue, jobs)


async def test_the_queue_waits_for_an_install_already_running(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, lamp), (button_id, button) = _setup(tmp_path)
    _auto_finish(source, clock, {lamp: "1.2.0", button: "1.9.15"})
    jobs.start(button_id, BUTTON_TARGET)
    queue.enqueue([lamp_id, button_id])
    queue.start()
    await _idle(queue)

    assert source.started == [(button, BUTTON_TARGET), (lamp, LAMP_TARGET)]
    assert store.firmware_status.queued() == []
    await _close(queue, jobs)


async def test_enqueue_clears_a_halt(tmp_path):
    store, source, clock, jobs, queue, (lamp_id, _), _ = _setup(tmp_path)
    store.firmware_settings.set_queue_halted_reason(HALTED_UNSUPPORTED)
    queue.enqueue([lamp_id])
    assert store.firmware_settings.get_queue_halted_reason() is None
    await _close(queue, jobs)
