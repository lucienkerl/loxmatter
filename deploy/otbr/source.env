# The pinned OpenThread border router build (spec
# docs/superpowers/specs/2026-09-14-thread-setup-without-handwork-design.md,
# section 3.1). Read by .github/workflows/otbr-image.yml (which builds this
# exact commit with this exact option) and by tests/test_otbr_image.py
# (which checks that deploy/testhost/docker-compose.yml's default image
# still matches). This is the same commit and the same options as the image
# that has been running on the test Pi since 14 September - the build is the
# one measured there.
OT_BR_POSIX_COMMIT=2ba12d24f4d1efad78c1e1b0e5960d65aa5a9fd7
OTBR_OPTIONS=-DOT_RCP_RESTORATION_MAX_COUNT=2
OTBR_IMAGE_TAG=2ba12d24-rcp2
